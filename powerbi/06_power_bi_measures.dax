// COMPARISON DIFFERENCE
Comparison Difference =
VAR SelectedMetric =
    SELECTEDVALUE('Comparison Metrics'[Metric])

VAR GlosTotal =
    CALCULATE(
        SUM(vw_provider_monthly[total_waiting]),
        REMOVEFILTERS(
            vw_provider_monthly[region_code],
            vw_provider_monthly[provider_code],
            vw_provider_monthly[provider_name]
        ),
        vw_provider_monthly[provider_code] = "RTE"
    )

VAR EnglandTotal =
    CALCULATE(
        SUM(vw_provider_monthly[total_waiting]),
        REMOVEFILTERS(
            vw_provider_monthly[region_code],
            vw_provider_monthly[provider_code],
            vw_provider_monthly[provider_name]
        )
    )

VAR GlosWithin =
    CALCULATE(
        SUM(vw_provider_monthly[within_18_weeks]),
        REMOVEFILTERS(
            vw_provider_monthly[region_code],
            vw_provider_monthly[provider_code],
            vw_provider_monthly[provider_name]
        ),
        vw_provider_monthly[provider_code] = "RTE"
    )

VAR EnglandWithin =
    CALCULATE(
        SUM(vw_provider_monthly[within_18_weeks]),
        REMOVEFILTERS(
            vw_provider_monthly[region_code],
            vw_provider_monthly[provider_code],
            vw_provider_monthly[provider_name]
        )
    )

VAR GlosPct =
    DIVIDE(GlosWithin, GlosTotal)

VAR EnglandPct =
    DIVIDE(EnglandWithin, EnglandTotal)

VAR Glos52 =
    CALCULATE(
        SUM(vw_provider_monthly[over_52_weeks]),
        REMOVEFILTERS(
            vw_provider_monthly[region_code],
            vw_provider_monthly[provider_code],
            vw_provider_monthly[provider_name]
        ),
        vw_provider_monthly[provider_code] = "RTE"
    )

VAR England52 =
    CALCULATE(
        SUM(vw_provider_monthly[over_52_weeks]),
        REMOVEFILTERS(
            vw_provider_monthly[region_code],
            vw_provider_monthly[provider_code],
            vw_provider_monthly[provider_name]
        )
    )

VAR Glos65 =
    CALCULATE(
        SUM(vw_provider_monthly[over_65_weeks]),
        REMOVEFILTERS(
            vw_provider_monthly[region_code],
            vw_provider_monthly[provider_code],
            vw_provider_monthly[provider_name]
        ),
        vw_provider_monthly[provider_code] = "RTE"
    )

VAR England65 =
    CALCULATE(
        SUM(vw_provider_monthly[over_65_weeks]),
        REMOVEFILTERS(
            vw_provider_monthly[region_code],
            vw_provider_monthly[provider_code],
            vw_provider_monthly[provider_name]
        )
    )

VAR Glos78 =
    CALCULATE(
        SUM(vw_provider_monthly[over_78_weeks]),
        REMOVEFILTERS(
            vw_provider_monthly[region_code],
            vw_provider_monthly[provider_code],
            vw_provider_monthly[provider_name]
        ),
        vw_provider_monthly[provider_code] = "RTE"
    )

VAR England78 =
    CALCULATE(
        SUM(vw_provider_monthly[over_78_weeks]),
        REMOVEFILTERS(
            vw_provider_monthly[region_code],
            vw_provider_monthly[provider_code],
            vw_provider_monthly[provider_name]
        )
    )

RETURN
SWITCH(
    SelectedMetric,

    "Total Waiting List",
        "—",

    "% Within 18 Weeks",
        FORMAT(
            (GlosPct - EnglandPct) * 100,
            "+0.0;-0.0;0.0"
        ) & " pp",

    "52+ Week Waits",
        FORMAT(
            DIVIDE(Glos52 - England52, England52),
            "+0.0%;-0.0%;0.0%"
        ),

    "65+ Week Waits",
        FORMAT(
            DIVIDE(Glos65 - England65, England65),
            "+0.0%;-0.0%;0.0%"
        ),

    "78+ Week Waits",
        FORMAT(
            DIVIDE(Glos78 - England78, England78),
            "+0.0%;-0.0%;0.0%"
        )
)